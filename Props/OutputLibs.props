<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <OBJ_BASE_DIR>$(SolutionDir)Objs</OBJ_BASE_DIR>
    <LIB_BASE_DIR>$(SolutionDir)Libs</LIB_BASE_DIR>
    <BIN_BASE_DIR>$(SolutionDir)Bin</BIN_BASE_DIR>
    <CONFIG_NAME>$(Platform)-$(Configuration)</CONFIG_NAME>
    <OUTDIR_CONFIG>$(CONFIG_NAME)\$(TargetFramework)</OUTDIR_CONFIG>
  </PropertyGroup>

  <!--  NET プロジェクト (C#, VB.NET) の設定  -->
  <PropertyGroup
      Condition="'$(MSBuildProjectExtension)' == '.csproj' Or '$(MSBuildProjectExtension)' == '.vbproj'">
    <INT_DIR>$(OBJ_BASE_DIR)\$(OUTPUT_CONFIG)\$(MSBuildProjectName)</INT_DIR>
    <BaseIntermediateOutputPath>$(OBJ_BASE_DIR)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(INT_DIR)\</IntermediateOutputPath>

    <OutDir>$(LIB_BASE_DIR)\$(OUTDIR_CONFIG)\$(MSBuildProjectName)\</OutDir>
  </PropertyGroup>

  <!--  C++ 系のプロジェクト (.vcxproj) の共通設定  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <OutDir>$(LIB_BASE_DIR)\$(CONFIG_NAME)\$(MSBuildProjectName)\</OutDir>
  </PropertyGroup>

  <!--  C++/CLI ラッパーの設定  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj' And '$(TargetFramework)' != ''">
    <IntDir>$(OBJ_BASE_DIR)\$(CONFIG_NAME)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj' And '$(TargetFramework)' == ''">
    <IntDir>$(OBJ_BASE_DIR)\$(CONFIG_NAME)\$(MSBuildProjectName)\Native\</IntDir>
  </PropertyGroup>

</Project>
