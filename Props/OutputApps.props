<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <CONFIG_NAME>$(Platform)-$(Configuration)</CONFIG_NAME>
    <OUTDIR_CONFIG>$(CONFIG_NAME)\$(TargetFramework)</OUTDIR_CONFIG>
    <INT_DIR>$(OBJ_BASE_DIR)\$(CONFIG_NAME)\$(MSBuildProjectName)</INT_DIR>
  </PropertyGroup>

  <PropertyGroup>
    <BaseIntermediateOutputPath>$(OBJ_BASE_DIR)\</BaseIntermediateOutputPath>
    <IntDir>$(INT_DIR)\</IntDir>
    <IntermediateOutputPath>$(INT_DIR)\</IntermediateOutputPath>

    <OutDir>$(BIN_BASE_DIR)\$(OUTDIR_CONFIG)\$(MSBuildProjectName)\</OutDir>
  </PropertyGroup>

</Project>
